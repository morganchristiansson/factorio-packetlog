# Local configuration may contain credentials; commit only *.example files
config*.yaml

# Capture artifacts
*.pcap
captures/
logs/

# Downloaded saves (40+ MB; recover the roster from them, don't commit them)
*.zip
# Server truth dumps pulled for format work (RCON console output)
truth.txt
pos.txt
mod-settings.dat

# Runtime state
players-cache.json
players-locale.json
# legacy pre-rename name (migrated on first load)
players.json

# Large game reference dumps (external/ is downloaded/generated)
external/
hivemind-session.json

# Hivemind long-term memory (written by memory compaction on quit / /compact)
memories/

# Bundler (bundle install inside the dev container)
/vendor/
/.bundle/

# stray session tmp files
.tmp

# scratch/ — pulled from the live server for format work (the save, the
# client's mod settings, the RCON console truth dumps) and other throwaway
# artefacts. Nothing in the repo reads it; nothing in it belongs in git.
scratch/

# editor scratch
*.kate-swp
tmp.txt
