# ─────────────────────────────────────────────────────────────
# Hivemind AI agent — required configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to config-hivemind.yaml. The sniffer requires this file;
# every setting below is required unless a model explicitly overrides it.
# The API key is the only secret and is read from HIVE_API_KEY.
# The sniffer exposes no Hivemind CLI args.

# Current startup model; must appear under some provider below.
model: "deepseek-v4-flash"

# One entry per endpoint/credential set. Every model listed under a
# provider uses that provider's RubyLLM provider, api_base and api_key_env
# (a model entry may still override any of them). Order — providers, then
# models within a provider — is the /model, /try and fallback order.
providers:
  opencode-zen:
    provider: openai
    api_base: "https://opencode.ai/zen/go/v1"
    api_key_env: HIVE_API_KEY
    models:
      - deepseek-v4-flash
      - gpt-4o

# Default provider/endpoint for a provider group that omits one.
provider: openai
api_base: "https://opencode.ai/zen/go/v1"

# Max unread console lines kept between prompts.
history_size: 1000

# Per-line clip in the history context.
history_line_len: 120

# Truncate replies to fit Factorio chat's ~500 char limit.
max_reply_len: 400

# Recent-context budget kept after compaction.
trim_tail_chars: 20000

# Auto-compaction gate (conversation characters).
auto_compaction_min_chars: 400000

# Chat trigger phrases.
triggers:
  - hivemind
  - good bot
  - goodbot
  - hm
  - hive

# Game-log events that fire a dedicated turn.
log_turn_events:
  - map-reset

# Per-player chat/greeting rate limits, in seconds.
min_interval: 5
greet_interval: 10

# Minimum seconds between dedicated log-event turns.
log_event_interval: 300
