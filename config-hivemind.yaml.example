# ─────────────────────────────────────────────────────────────
# Hivemind AI agent — config example
# ─────────────────────────────────────────────────────────────
# The API key is the only secret and is read from HIVE_API_KEY.
# Other settings belong here; the sniffer exposes no Hivemind CLI args.

# Current startup model.
model: "deepseek-v4-flash"

# Models available to /model and automatic fallback, in order.
# Each entry may define provider, api_base, api_key_env, or api_key.
# api_key_env is preferred for secrets; HIVE_API_KEY overrides api_key.
models:
  - name: deepseek-v4-flash
    provider: openai
    api_base: "https://opencode.ai/zen/go/v1"
    api_key_env: HIVE_API_KEY
  - name: gpt-4o
    provider: openai
    api_base: "https://opencode.ai/zen/go/v1"
    api_key_env: HIVE_API_KEY

# Optional global defaults for models that omit a field.
provider: openai
api_base: "https://opencode.ai/zen/go/v1"

# Max unread console lines kept between prompts.
history_size: 1000

# Per-line clip in the history context.
history_line_len: 120

# Truncate replies to fit Factorio chat's ~500 char limit.
max_reply_len: 400

# Recent-context budget kept after compaction.
trim_tail_chars: 20000

# Auto-compaction gate (conversation characters).
auto_compaction_min_chars: 400000

# Chat trigger phrases.
triggers:
  - hivemind
  - good bot
  - goodbot
  - hm
  - hive

# Game-log events that fire a dedicated turn.
log_turn_events:
  - map-reset
