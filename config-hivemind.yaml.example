# ─────────────────────────────────────────────────────────────
# Hivemind AI agent — required configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to config-hivemind.yaml. The sniffer requires this
# file and every TOP-LEVEL setting below (it refuses to start on a
# missing one). Only the per-provider fields marked OPTIONAL may be
# left out or commented.
# The API key comes from the env (HIVE_API_KEY by default) or the
# provider group's `api_key:` here; env wins. The file is gitignored,
# so a key in it stays local.
# The sniffer exposes no Hivemind CLI args.

# Current startup model; must appear under some provider below.
model: "deepseek-v4-flash"

# One entry per endpoint/credential set. Every model listed under a
# provider uses that provider's provider/api_base/api_key_env; a model
# entry may still override any of them. Order — providers, then models
# within a provider — is the /model, /try and fallback order.
providers:
  opencode-zen:
    # The endpoint lives with the group — required here, no top-level
    # defaults, so a second group can't silently reuse the first one's.
    provider: openai
    api_base: "https://opencode.ai/zen/go/v1"
    # OPTIONAL — the key for this group. The env var overrides it
    # (api_key_env names the var, HIVE_API_KEY by default), so CI can
    # inject it without touching this file.
    # api_key_env: HIVE_API_KEY
    # api_key: "sk-..."
    models:
      - deepseek-v4-flash
      # OPTIONAL form — a hash may override any group field but `provider`
      #   - name: gpt-4o
      #     api_base: "https://elsewhere/v1"
      - gpt-4o

# Max unread console lines kept between prompts.
history_size: 1000

# Per-line clip in the history context.
history_line_len: 120

# Truncate replies to fit Factorio chat's ~500 char limit.
max_reply_len: 400

# Recent-context budget kept after compaction.
trim_tail_chars: 20000

# Auto-compaction gate (conversation characters).
auto_compaction_min_chars: 400000

# Chat trigger phrases.
triggers:
  - hivemind
  - good bot
  - goodbot
  - hm
  - hive

# Game-log events that fire a dedicated turn.
log_turn_events:
  - map-reset

# Per-player chat/greeting rate limits, in seconds.
min_interval: 5
greet_interval: 10

# Minimum seconds between dedicated log-event turns.
log_event_interval: 300
