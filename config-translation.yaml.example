# ─────────────────────────────────────────────────────────────
# Translation agent — required configuration
# ─────────────────────────────────────────────────────────────
# Copy to config-translation.yaml. The translation plugin refuses to start
# without this file and every key marked below (they are required — there
# are no code defaults; a missing key is a startup error, reported as
# "[translate] Translation agent disabled: ...").
# The Google key is the one optional key: it is a secret (env first, then
# `google_api_key:` here) and is required only by the google/hybrid backends,
# which refuse to start without it.
# ─────────────────────────────────────────────────────────────

# Translation backend: argos, google, hybrid, mock.
# ONE backend is active at a time — hybrid is argos primary with Google
# Cloud as fallback for pairs argos lacks (pt<->ru), not a list you
# configure. No key needed for argos/mock. argos needs the CLI (auto-detected
# on PATH, then /opt/argos/bin) plus at least one language pack — a missing
# binary or packs is a startup error, not a silent no-op.
backend: argos

# Google Cloud Translation key — used by the google and hybrid backends
# only. The env var overrides this, so ops/CI can inject it without
# editing the file; this file is gitignored, so a key here stays local.
# google_api_key: AIza...

# Equivalent env override (wins over the value above):
#   GOOGLE_TRANSLATE_API_KEY=... sudo ruby factorio-packettools.rb

# Locales to translate between. 'en' is always the pivot
# (translation target) — English speakers get relayed to other
# whitelisted readers. Translation occurs between all listed
# locales when players using them are online.
whitelist:
  - en
  - pt
  - ru

# Minimum seconds between translations of the same player (anti-spam).
min_interval: 2
