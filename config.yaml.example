# ─────────────────────────────────────────────────────────────
# Factorio Packet Sniffer — config example
# ─────────────────────────────────────────────────────────────
# Copy to config.yaml and edit. Only `plugins:` is MANDATORY (it says which
# features run — there is no hardcoded default); every other setting is
# optional and commented out below already carries its default, so copying
# this file unchanged changes nothing.
#
# Secrets (RCON password, API keys, credentials: RCON_PASSWORD,
# HIVE_API_KEY, FACTORIO_USERNAME, FACTORIO_TOKEN) are env-only — never
# here. Exception: the Google Translate key may live in
# config-translation.yaml as `google_api_key:` (env still overrides it).
# ─────────────────────────────────────────────────────────────

# REQUIRED — the features to load. The sniffer refuses to start without
# this key, so the feature set is always an explicit choice. Remove an entry
# to switch that feature off entirely (nothing of it is even loaded); list
# `plugins: []` to run on no features at all. Hivemind's own plugins
# (persistence, compaction, followups) are NOT listed here — they live in
# config-hivemind.yaml.
#   hivemind      the AI agent answering players who say "hivemind"
#   translation   relays chat to players who can't read the original
#   quickbar_backup  keeps a name-keyed copy of every player's quickbar
#                    (quickbars.json) and puts it back when they join a
#                    save that has none — game indexes reset with a save,
#                    players-cache.json does not survive one
plugins:
  - hivemind
  - translation
  - quickbar_backup

# Capture source (one: port, interface, or server mode)

# OPTIONAL (auto) — server mode: game port of the running server
# (default 34197)
# port: 34197

# OPTIONAL (auto) — the server's --bind IP's interface, else the
# default route; with a single non-loopback interface, just that one
# interface: null

# OPTIONAL (auto) — this host's Factorio IP(s): the server's bind IPs
# in server mode, our game client's IP in client mode (string or
# list, comma-separated allowed). The MODE decides which direction is
# kept — server mode keeps incoming client→server, client mode keeps
# server→client; the IP only filters. Setting it without `server:`
# forces client mode.
# ip: 192.168.1.10

# OPTIONAL (auto) — auto-true when a factorio server runs on this host;
# set false to force client mode
# server: true

# OPTIONAL — server mode only: skip RCON entirely
no_rcon: false

# Capture settings

# What lands in the pcap: normal (filtered — no keepalive-only
# heartbeats, no server-mode outgoing broadcasts, no map-download
# blocks), full (everything), save (ONLY the msg 13 map-download
# blocks, for tools/extract_save_from_pcap.rb)
capture: normal

save_capture_gz: true      # compress the pcap stream
keep: 72                  # retention: delete rotated files older than this
rotate_size: 256          # rotate the active capture file at this size (MB)
max_size: 512             # total budget for the rotated files (oldest
                           # deleted first); null = no byte budget

# Protocol

# OPTIONAL (auto) — RCON helpers.game_version (cached); set 2.0 or 2.1
# only for pcap analysis with no RCON
# protocol_version: 2.1

dump_raw_types: false     # print raw type ids for unknown action types
validate: false           # verify decoded actions against the game

# Logging
log_keep_days: 7          # prune logs/ older than this
debug: false              # decoded per-action lines (also /debug at runtime)

# Item/entity prototype dumps
# OPTIONAL — paths to dump files; when absent, server mode generates
# both from RCON at startup
# item_db: external/item_prototypes_runtime.txt
# entity_db: external/entity_prototypes_runtime.txt
